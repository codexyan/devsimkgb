# Contoh secret untuk menjalankan Worker secara lokal
# (opennextjs-cloudflare preview / wrangler dev).
#
# Salin file ini menjadi `.dev.vars` (sudah gitignored) lalu isi nilainya.
# Untuk `next dev` biasa gunakan .env, bukan file ini.

# Rahasia penanda-tangan sesi NextAuth (buat: openssl rand -base64 32)
NEXTAUTH_SECRET="ganti-dengan-rahasia-acak-panjang"

# Rahasia untuk melindungi endpoint cron /api/cron/notifikasi
CRON_SECRET="ganti-dengan-rahasia-acak-panjang"

# ===== Supabase (penyimpanan produksi) =====
# Secret key hanya untuk server karena melewati RLS.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_XXXXXXXX"

# ===== Google Sheets (mode Sheets-as-backend) =====
GOOGLE_SERVICE_ACCOUNT_EMAIL="nama-sa@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID="1AbC...."
