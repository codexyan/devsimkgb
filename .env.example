# Contoh konfigurasi environment untuk SIM-KGB.
# Salin file ini menjadi .env lalu isi nilai sebenarnya.
# JANGAN commit file .env (sudah di-gitignore). File ini hanya template, tanpa rahasia.

# ===== Database: Neon PostgreSQL =====
# DATABASE_URL: koneksi POOLED (pgbouncer) untuk runtime aplikasi (via driver adapter).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: koneksi DIRECT (non-pooled) untuk `prisma migrate` / CLI.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ===== NextAuth (v5) =====
# NEXTAUTH_SECRET: kunci penandatangan JWT. WAJIB acak dan rahasia di production.
# Generate: openssl rand -base64 32   (atau)   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="GANTI_DENGAN_SECRET_ACAK_32_BYTE"
# NEXTAUTH_URL: URL kanonik aplikasi. Lokal: http://localhost:3000
# Production: URL publik deployment (mis. https://devpassdm.vercel.app).
NEXTAUTH_URL="http://localhost:3000"

# ===== Vercel Blob: penyimpanan SK PDF (privat) =====
# Token dari Vercel dashboard -> Storage -> Blob store. Diawali "vercel_blob_rw_".
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_XXXXXXXX"

# ===== Cron =====
# CRON_SECRET: bearer token untuk endpoint /api/cron/notifikasi. Isi nilai acak di production.
CRON_SECRET="GANTI_DENGAN_SECRET_ACAK"

# ===== Google Sheets sebagai sumber data (opsional, mode Sheets-as-backend) =====
# Dari JSON key Service Account (Google Cloud → IAM → Service Accounts → Keys).
# 1) Aktifkan "Google Sheets API" di project.
# 2) Buat Service Account + JSON key.
# 3) Share spreadsheet ke email service account (akses Editor).
GOOGLE_SERVICE_ACCOUNT_EMAIL="nama-sa@project-id.iam.gserviceaccount.com"
# private_key dari JSON key. Tulis dalam SATU baris, ganti newline asli dengan \n.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# ID spreadsheet, ambil dari URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID="1AbC...."

# ===== Seed (dipakai hanya oleh `prisma db seed`) =====
SEED_PASSWORD_SDM="password_untuk_akun_admin_sdm"
SEED_PASSWORD_ADMIN="password_untuk_super_admin"
# Opsional; jika kosong akan memakai SEED_PASSWORD_SDM.
SEED_PASSWORD_HUKDIS="password_untuk_admin_hukdis"
